{
  "contract": "editarr-export-layout-1",
  "rules": {
    "jellyfinUserId": "32 lowercase hex digits, the plugin's Guid.ToString(\"N\"); the nil GUID is invalid. Provider input may be N or D form in any case; nothing else is repaired.",
    "localExportId": "local- followed by 32 lowercase hex digits, random, immutable, never all zero. A Jellyfin principal never selects a local ID.",
    "exportIdSegment": "Stored values and path segments must already be canonical.",
    "mediaStem": "Basename without its final extension. No dot keeps the whole name. A first-character-only dot or an empty final extension is unsupported_media_name.",
    "personal": "<media dir>/<format>/<export id>/<stem>.user-<export id>.<format>",
    "default": "<media dir>/<format>/<stem>.<format>",
    "legacy": "<media dir>/<stem>.<format>; preserved on disk, never selected.",
    "selection": "lstat the personal path. ENOENT or ENOTDIR means absent. A regular file is read and validated: read failure is personal_unreadable, validation failure is personal_invalid. Any other entry type (directory, symbolic link, device) is personal_invalid. Any other lstat error is personal_unreadable. Only an absent personal file consults the default path with the same rules and default_* outcomes. Neither present is none. Errors never fall back.",
    "validation": "EDL validity is the public plugin's EdlParser.Validate applied to File.ReadAllLinesAsync output, pinned by edlGrammar; Editarr's EDL import parser is not the selection validator. MCF accepts MovieContentFilter 1.0.0 and 1.1.0. EDL and MCF are selected independently."
  },
  "edlGrammar": {
    "source": {
      "repository": "jellyfin-edl-public",
      "commit": "7797442e8d23b8c5d0cbe6d554927c27c70b052e",
      "files": ["src/Jellyfin.Plugin.Edl/Services/EdlParser.cs", "src/Jellyfin.Plugin.Edl/Api/EdlController.cs"]
    },
    "rules": [
      "Decode UTF-8, dropping one leading byte order mark. Lines end at CRLF, LF, or a lone CR.",
      "Trim each line. Skip it when empty or when it starts with #, ; or //.",
      "Split the rest on whitespace. Fewer than three fields is invalid; fields after the third are ignored.",
      "Start and end are invariant-culture decimals: optional sign, digits with an optional point, or a point and digits, then an optional exponent. A comma is not a decimal point.",
      "End must be greater than start. Negative times are allowed.",
      "The action is 0, 1, 2, 3, cut, mute, scene, or commercial, compared case-insensitively.",
      "One invalid line makes the whole file invalid. A file with no action lines is valid."
    ],
    "unpinned": "NaN, Infinity, out-of-range numbers, non-UTF-8 encodings, and non-ASCII whitespace, digits, or letters. Payloads and vectors avoid them until the plugin pins them.",
    "vectors": [
      {"name": "editarr-export", "content": "## Editarr Simple EDL\n## other: Imported skip\n5.000 8.000 3", "valid": true},
      {"name": "empty-file", "content": "", "valid": true},
      {"name": "comments-and-blank-lines-only", "content": "# a\n; b\n// c\n   \n", "valid": true},
      {"name": "indented-comment", "content": "  # note\n0 1 3\n", "valid": true},
      {"name": "every-action-spelling", "content": "0 1 0\n1 2 1\n2 3 2\n3 4 3\n4 5 cut\n5 6 MUTE\n6 7 Scene\n7 8 commercial\n", "valid": true},
      {"name": "extra-fields-ignored", "content": "0 1 3 trailing words\n", "valid": true},
      {"name": "tabs-and-crlf", "content": "\t0\t1\t3\r\n1  2 1\r\n", "valid": true},
      {"name": "utf8-byte-order-mark", "content": "\ufeff0 1 3\n", "valid": true},
      {"name": "decimal-forms", "content": "+0.5 1.5e1 3\n.5 1. 1\n-2 -1E0 3\n", "valid": true},
      {"name": "unsorted-and-overlapping", "content": "10 20 3\n0 15 1\n", "valid": true},
      {"name": "lone-cr-separates-lines", "content": "0 1 3\r2 1 1", "valid": false},
      {"name": "two-fields", "content": "0 1\n", "valid": false},
      {"name": "start-not-a-number", "content": "start 1 3\n", "valid": false},
      {"name": "comma-decimal", "content": "0,5 2 3\n", "valid": false},
      {"name": "single-slash-is-not-a-comment", "content": "/ 0 1 3\n", "valid": false},
      {"name": "end-equals-start", "content": "1 1 3\n", "valid": false},
      {"name": "end-before-start", "content": "2 1 3\n", "valid": false},
      {"name": "numeric-action-out-of-range", "content": "0 1 4\n", "valid": false},
      {"name": "named-action-not-allowed", "content": "0 1 skip\n", "valid": false},
      {"name": "supported-row-then-unsupported-action", "content": "0 1 1\n0 1 999\n", "valid": false}
    ]
  },
